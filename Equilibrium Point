class Solution {
    public static int findEquilibrium(int arr[]) {
        // code here
        int rightSum = 0;
        for(int x:arr){
            rightSum+=x;
        }
        int leftSum=0;
        for(int i=0;i<arr.length;i++){
            leftSum+=arr[i];
            if(rightSum==leftSum){
                return i;
            }
            rightSum-=arr[i];
            
        }
        return -1;
    }
}
