class Solution {
    boolean isPalindrome(String s) {
        // code here
        int r = s.length()-1;
        int l = 0;
        while(l<r)
        {
            if(s.charAt(r)!=s.charAt(l))
            {
                return false;
            }
            r--;
            l++;
        }
        return true;
    }
}
